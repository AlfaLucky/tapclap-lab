# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace_with_at_least_24_random_characters
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
PUBLIC_READ=true
# false for local HTTP; true on Railway HTTPS
COOKIE_SECURE=false
RETENTION_DAYS=7
ARTIFACT_BUDGET_MB=1000
MAX_RUN_SECONDS=1200
LIVE_FPS=4
